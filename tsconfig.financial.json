{
  "//": "Strict-mode opt-in for financial-engine modules. Run with `tsc -p tsconfig.financial.json` in CI to gate regressions while the global strict rollout is in progress (see docs/strict-mode-rollout.md).",
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noEmit": true
  },
  "include": [
    "src/vite-env.d.ts",
    "src/lib/quantis-math.ts",
    "src/lib/financial-engine.ts",
    "src/lib/reconciliation-engine.ts",
    "src/lib/formula-registry.ts",
    "src/lib/geo-calibrator.ts",
    "src/financial/result.ts",
    "src/financial/payback.ts",
    "src/financial/cac-payback.ts",
    "src/financial/reconcile.ts"
  ]
}
