# Local environment files — NEVER commit; Supabase/Lovable reverts these to stale values.
# CI reads VITE_* vars from GitHub Secrets (production environment), not from .env.
# For local dev: copy .env.example and fill in your values.
.env
.env.local
.env.*.local

# Vercel build artifacts — never commit; diverged artifacts mask real source state
.vercel/

# Supabase CLI temp files — auto-generated, not source
supabase/.temp/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
