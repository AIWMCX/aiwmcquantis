{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build:vercel",
  "outputDirectory": "dist",
  "framework": "vite",
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": false,
  "trailingSlash": false,

  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/(.*)", "destination": "/index.html" },
    { "source": "/scenario", "destination": "/index.html" },\n    { "source": "/engagement-intake", "destination": "/index.html" },\n    { "source": "/engagement-workspace", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/settings/(.*)", "destination": "/index.html" },
    { "source": "/dev/(.*)", "destination": "/index.html" },
    { "source": "/share/(.*)", "destination": "/index.html" },
    { "source": "/r/(.*)", "destination": "/index.html" },
    { "source": "/auth", "destination": "/index.html" },
    { "source": "/auth/(.*)", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/email-confirmed", "destination": "/index.html" },
    { "source": "/email-preferences", "destination": "/index.html" },
    { "source": "/thank-you", "destination": "/index.html" },
    { "source": "/trial", "destination": "/index.html" },
    { "source": "/plus-settings", "destination": "/index.html" },
    { "source": "/pro-settings", "destination": "/index.html" },
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/connect", "destination": "/index.html" },
    { "source": "/directory-tracker", "destination": "/index.html" },
    { "source": "/quote", "destination": "/index.html" },
    { "source": "/viral-content", "destination": "/index.html" },
    { "source": "/viral-posts", "destination": "/index.html" },
    { "source": "/__maintenance", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security","value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy",       "value": "camera=(), microphone=(), geolocation=(self), payment=(self)" },
        { "key": "X-DNS-Prefetch-Control",   "value": "on" },
        { "key": "Content-Security-Policy",  "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://*.posthog.com https://*.sentry.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.posthog.com https://*.sentry.io; frame-src https://js.stripe.com https://hooks.stripe.com; upgrade-insecure-requests" }
      ]
    }
  ]
}
