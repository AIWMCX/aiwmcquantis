{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build:vercel",
  "outputDirectory": "dist",
  "framework": "vite",
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/sample-report/quantis-sample-report.pdf", "destination": "/#single-input-hero", "permanent": true },
    { "source": "/cases", "destination": "/examples", "permanent": true },
    { "source": "/linkedin", "destination": "https://www.linkedin.com/in/bogdan-jeltov-6218b9324/", "permanent": false }
  ],

  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/(.*)", "destination": "/index.html" },
    { "source": "/scenario", "destination": "/index.html" },
    { "source": "/engagement-intake", "destination": "/index.html" },
    { "source": "/engagement-workspace", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/settings/(.*)", "destination": "/index.html" },
    { "source": "/dev/(.*)", "destination": "/index.html" },
    { "source": "/share/(.*)", "destination": "/index.html" },
    { "source": "/r/(.*)", "destination": "/index.html" },
    { "source": "/auth", "destination": "/index.html" },
    { "source": "/auth/(.*)", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/email-confirmed", "destination": "/index.html" },
    { "source": "/email-preferences", "destination": "/index.html" },
    { "source": "/thank-you", "destination": "/index.html" },
    { "source": "/trial", "destination": "/index.html" },
    { "source": "/plus-settings", "destination": "/index.html" },
    { "source": "/pro-settings", "destination": "/index.html" },
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/connect", "destination": "/index.html" },
    { "source": "/directory-tracker", "destination": "/index.html" },
    { "source": "/quote", "destination": "/index.html" },
    { "source": "/demo/founder-decision-review", "destination": "/demo/founder-decision-review/index.html" },
    { "source": "/demo/hiring-decision", "destination": "/demo/hiring-decision/index.html" },
    { "source": "/demo/price-change", "destination": "/demo/price-change/index.html" },
    { "source": "/demo/second-location", "destination": "/demo/second-location/index.html" },
    { "source": "/demo/sample-decision-memo", "destination": "/demo/sample-decision-memo/index.html" },
    { "source": "/demo/consultant-founding-pilot", "destination": "/demo/consultant-founding-pilot/index.html" },
    { "source": "/invite/(.*)", "destination": "/invite/index.html" },
    { "source": "/viral-content", "destination": "/index.html" },
    { "source": "/viral-posts", "destination": "/index.html" },
    { "source": "/__maintenance", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/r/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    { "source": "/app/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/scenario", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/engagement-intake", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/engagement-workspace", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/settings/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/dev/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/share/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/auth", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/auth/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/reset-password", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/email-confirmed", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/email-preferences", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/thank-you", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/trial", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/plus-settings", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/pro-settings", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/docs", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/directory-tracker", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/quote", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/viral-content", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/viral-posts", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/__maintenance", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security","value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy",       "value": "camera=(), microphone=(), geolocation=(self), payment=(self)" },
        { "key": "X-DNS-Prefetch-Control",   "value": "on" },
        { "key": "Content-Security-Policy",  "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://www.clarity.ms https://scripts.clarity.ms https://assets.apollo.io https://*.sentry.io https://va.vercel-scripts.com https://connect.facebook.net https://analytics.tiktok.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' https://fonts.gstatic.com https://cdn.fontshare.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://stats.g.doubleclick.net https://www.google.com https://www.clarity.ms https://*.clarity.ms https://assets.apollo.io https://*.apollo.io https://aplo-evnt.com https://*.aplo-evnt.com https://*.sentry.io https://va.vercel-scripts.com https://vitals.vercel-insights.com https://www.facebook.com https://connect.facebook.net https://analytics.tiktok.com https://analytics-ipv6.tiktokw.us https://*.tiktok.com; frame-src https://js.stripe.com https://hooks.stripe.com; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" }
      ]
    }
  ]
}
