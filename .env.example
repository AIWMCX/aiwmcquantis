# AIWMC Quantis — environment variable reference
# Copy this file to .env and fill in your values for local development.
# CI/CD: set these as GitHub Secrets in the "production" environment.
# NEVER commit .env — it is gitignored.

# ── Supabase (frontend / client-side) ──────────────────────────────────────
# Canonical production project: dmlxrvfyqsakyjomsvdj
VITE_SUPABASE_URL="https://dmlxrvfyqsakyjomsvdj.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon key from supabase.com → project → API settings>"
VITE_SUPABASE_PROJECT_ID="dmlxrvfyqsakyjomsvdj"

# ── Server-side secrets (edge functions only — never VITE_ prefix) ──────────
# Set these in Supabase dashboard → project → Settings → Edge Functions → Secrets
# DEEPSEEK_API_KEY=<your DeepSeek API key>
# CRON_SECRET=<random hex, e.g. openssl rand -hex 32>
# STRIPE_SECRET_KEY=<sk_live_...>
# STRIPE_WEBHOOK_SECRET=<whsec_...>
# ADMIN_UPLOAD_KEY=<random string>

# ── Dahl inference (server-side only — never a VITE_/NEXT_PUBLIC_ prefix) ──
# DAHL_API_KEY must never have a sample/placeholder value here or anywhere
# else in this repo, per the integration's security rules. Set the real key
# directly in Supabase → project → Settings → Edge Functions → Secrets.
# DAHL_API_KEY=
# DAHL_BASE_URL=https://inference.dahl.global/v1
# DAHL_ENABLED=false
# DAHL_FALLBACK_ENABLED=false
# DAHL_DEFAULT_ALIAS=general
# DAHL_REQUEST_TIMEOUT_MS=60000
# DAHL_MAX_RETRIES=2
# Rollout/canary gate (see supabase/functions/_shared/dahl-canary.ts). Not
# secret -- kept as GitHub Actions repo *variables*, not secrets, and synced
# the same way. DAHL_ENABLED=true alone does NOT route any traffic; every
# request still needs DAHL_CANARY_MODE to say it's eligible.
# DAHL_CANARY_MODE=off              # off | admin_only | percent
# DAHL_CANARY_ADMIN_USER_IDS=       # comma-separated Supabase auth.users UUIDs
# DAHL_CANARY_PERCENT=0             # 0-100, only used when mode=percent
