# AIWMC Quantis — environment variable reference
# Copy this file to .env and fill in your values for local development.
# CI/CD: set these as GitHub Secrets in the "production" environment.
# NEVER commit .env — it is gitignored.

# ── Supabase (frontend / client-side) ──────────────────────────────────────
# Canonical production project: dmlxrvfyqsakyjomsvdj
VITE_SUPABASE_URL="https://dmlxrvfyqsakyjomsvdj.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon key from supabase.com → project → API settings>"
VITE_SUPABASE_PROJECT_ID="dmlxrvfyqsakyjomsvdj"

# ── Server-side secrets (edge functions only — never VITE_ prefix) ──────────
# Set these in Supabase dashboard → project → Settings → Edge Functions → Secrets
# DEEPSEEK_API_KEY=<your DeepSeek API key>
# CRON_SECRET=<random hex, e.g. openssl rand -hex 32>
# STRIPE_SECRET_KEY=<sk_live_...>
# STRIPE_WEBHOOK_SECRET=<whsec_...>
# ADMIN_UPLOAD_KEY=<random string>
